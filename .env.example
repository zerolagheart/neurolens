# Copy to .env and adjust. Placeholders only: never put credentials in this file.

# Where trained runs live (each run: <dir>/<name>/best.pt + best_meta.json)
NEUROLENS_RUNS_DIR=artifacts/runs
NEUROLENS_REPORTS_DIR=artifacts/reports
NEUROLENS_AUDIT_DIR=artifacts/audit
NEUROLENS_SPLITS_DIR=artifacts/splits
NEUROLENS_DATA_ROOT=data/raw/brain-tumor-mri-dataset

# Run name served by default (empty = first discovered run)
NEUROLENS_DEFAULT_MODEL=
# cpu | cuda | auto
NEUROLENS_DEVICE=cpu
NEUROLENS_MAX_MODELS=4
NEUROLENS_MAX_UPLOAD_MB=10

# Comma-separated list of allowed browser origins
NEUROLENS_CORS_ORIGINS=http://localhost:8501

# Abstention policy (illustrative defaults, not clinically validated thresholds)
NEUROLENS_ABSTENTION_ENABLED=true
NEUROLENS_MIN_CONFIDENCE=0.70
NEUROLENS_MAX_NORMALIZED_ENTROPY=0.60

NEUROLENS_LOG_LEVEL=INFO
NEUROLENS_LOG_JSON=0

# Streamlit: leave empty to run models in-process; set to use the FastAPI service instead
NEUROLENS_API_URL=
